{
	"name": "dynamic-book-archive",
	"private": true,
	"type": "module",
	"scripts": {
		"build:css": "tailwindcss -i ./src/css/input.css -o ./assets/css/app.min.css --minify",
		"watch:css": "tailwindcss -i ./src/css/input.css -o ./assets/css/app.min.css --watch",
		"build:images": "cpx \"src/images/**/*\" assets/images",
		"watch:images": "cpx \"src/images/**/*\" assets/images --watch",
		"build:vendor": "composer dump-autoload -o --no-interaction",
		"build:js": "esbuild src/js/navigation.js src/js/book-single-gallery.js src/js/book-archive-toolbar-selects.js src/js/customizer.js --outdir=assets/js --entry-names=[name].min --minify --target=es2018",
		"watch:js": "esbuild src/js/navigation.js src/js/book-single-gallery.js src/js/book-archive-toolbar-selects.js src/js/customizer.js --outdir=assets/js --entry-names=[name].min --minify --target=es2018 --watch",
		"watch": "concurrently -n css,images,vendor,js \"npm run watch:css\" \"npm run watch:images\" \"npm run watch:vendor\" \"npm run watch:js\"",
		"bundle": "npm run build:css && npm run build:js"
	},
	"devDependencies": {
		"@tailwindcss/cli": "^4.1.0",
		"@tailwindcss/typography": "^0.5.16",
		"esbuild": "^0.25.0",
		"tailwindcss": "^4.1.0"
	}
}
