{
	"name": "dynamic-book-archive",
	"private": true,
	"type": "module",
	"version": "1.4.1",
	"scripts": {
		"build:css": "tailwindcss -i ./src/css/app.css -o ./assets/css/app.min.css --minify",
		"watch:css": "tailwindcss -i ./src/css/app.css -o ./assets/css/app.min.css --watch",
		"build:images": "cpx \"src/images/**/*\" assets/images",
		"watch:images": "cpx \"src/images/**/*\" assets/images --watch",
		"build:vendor": "composer dump-autoload -o --no-interaction",
		"build:js": "esbuild src/js/interactive/index.js src/js/cf7-slim-select.js src/js/cf7-response-dismiss.js src/js/customizer.js --bundle --format=iife --outdir=assets/js --entry-names=[name].min --minify --target=es2018",
		"watch:js": "esbuild src/js/interactive/index.js src/js/cf7-slim-select.js src/js/cf7-response-dismiss.js src/js/customizer.js --bundle --format=iife --outdir=assets/js --entry-names=[name].min --minify --target=es2018 --watch",
		"watch": "concurrently -n css,images,vendor,js \"npm run watch:css\" \"npm run watch:images\" \"npm run watch:vendor\" \"npm run watch:js\"",
		"bundle:composer": "composer install --no-dev --optimize-autoloader --no-interaction",
		"bundle": "npm run build:css && npm run build:js && npm run build:images && npm run bundle:composer && node scripts/bundle.mjs"
	},
	"devDependencies": {
		"@tailwindcss/cli": "^4.3.0",
		"@tailwindcss/typography": "^0.5.16",
		"alpinejs": "^3.15.12",
		"concurrently": "^9.1.2",
		"cpx2": "^8.0.2",
		"esbuild": "^0.25.0",
		"tailwindcss": "^4.3.0"
	},
	"dependencies": {
		"@tailwindcss/postcss": "^4.3.0"
	}
}
